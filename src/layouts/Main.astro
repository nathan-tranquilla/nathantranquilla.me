---
import "../styles/global.css";
import Body from "../components/Body.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

// The nt mark, generated from the site's own logo
import favicon16 from "../assets/favicon-nt-16.png";
import favicon32 from "../assets/favicon-nt-32.png";
import favicon48 from "../assets/favicon-nt-48.png";
import favicon96 from "../assets/favicon-nt-96.png";
import favicon180 from "../assets/favicon-nt-180.png";
import favicon192 from "../assets/favicon-nt-192.png";
import favicon256 from "../assets/favicon-nt-256.png";
import favicon512 from "../assets/favicon-nt-512.png";
const ogImageDefault = "/og-image.webp";

export interface Props {
  title: string;
  classes?: string;
  nonav?: boolean;
  description?: string;
  ogImage?: string;
  ogType?: string;
  breadcrumbTitle?: string;
  articleMeta?: {
    author: string;
    publishedTime: string;
    modifiedTime: string;
    tags: string[];
  };
}

const defaultDescription = "Nathan Tranquilla writes about type safety and AI in software development.";

const { title, classes, nonav = false, description = defaultDescription, ogImage, ogType = "website", breadcrumbTitle, articleMeta } = Astro.props;

const websiteUrl = "https://nathantranquilla.me";
const canonicalUrl = new URL(Astro.url.pathname, websiteUrl).href;
const ogImageUrl = ogImage || `${websiteUrl}${ogImageDefault}`;
const isProd = import.meta.env.PROD;

// Generate breadcrumb schema
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": websiteUrl }
];

pathSegments.forEach((segment, index) => {
  const name = breadcrumbTitle && index === pathSegments.length - 1
    ? breadcrumbTitle
    : segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' ');
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": index + 2,
    "name": name,
    "item": `${websiteUrl}/${pathSegments.slice(0, index + 1).join('/')}`
  });
});

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};
---

<html lang="en">
  <head>
    {isProd && (
      <Fragment>
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-MCZFYVP6CG"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", "G-MCZFYVP6CG");
        </script>
      </Fragment>
    )}
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=2"
    />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="theme-color" content="#1a1a1a" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1a1a1a" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nathan Tranquilla" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="nathantranquilla.me" />
    <meta property="og:locale" content="en_US" />
    {articleMeta && (
      <Fragment>
        <meta property="article:author" content={articleMeta.author} />
        <meta property="article:published_time" content={articleMeta.publishedTime} />
        <meta property="article:modified_time" content={articleMeta.modifiedTime} />
        <meta property="article:section" content="Web Development" />
        {articleMeta.tags.map((tag: string) => (
          <meta property="article:tag" content={tag} />
        ))}
      </Fragment>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Favicon and Icons -->
    <link rel="icon" type="image/png" sizes="16x16" href={favicon16.src} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
    <link rel="icon" type="image/png" sizes="48x48" href={favicon48.src} />
    <link rel="icon" type="image/png" sizes="96x96" href={favicon96.src} />

    <!-- Apple Touch Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href={favicon180.src} />

    <!-- Android/Chrome Icons -->
    <link rel="icon" type="image/png" sizes="192x192" href={favicon192.src} />
    <link rel="icon" type="image/png" sizes="256x256" href={favicon256.src} />
    <link rel="icon" type="image/png" sizes="512x512" href={favicon512.src} />

    <!-- Default favicon -->
    <link rel="shortcut icon" href={favicon32.src} />

    <!-- Mobile Web App -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Nathan Tranquilla" />

    <meta name="email" content="tranquilla.nathan@pm.me" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="author" href="https://nathantranquilla.me/about" />

    <meta name="keywords" content="Nathan Tranquilla, software development, web development, type safety, ReScript, TypeScript, type systems, functional programming, AI, AI agents, software engineering" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  </head>
  <Body>
    {!nonav && <Header />}
    <main class={`col-start-1 col-end-4 row-start-2 ${classes || ""}`}>
      {!nonav && <Breadcrumb title={breadcrumbTitle} />}
      <slot />
    </main>
    {!nonav && <Footer />}
  </Body>


</html>
