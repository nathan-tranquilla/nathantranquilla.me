---
// UI library: the blog index's control bar. Sticky just under the site
// header, with the result count on the right.
//
// One horizontal tray spans the column: the page colour inside a 1px navy
// border, holding the chips and, at its right end, the result count. The
// chips sit inline in one row in it, with the chips in paper on it in light mode (through the
// --tag-bg surface variable), set apart by their ink outline. Dark mode flips
// the border through its token and keeps the chips' slate fill. Where they
// don't fit (a phone), the row scrolls sideways within it, and each end that
// still hides chips gets a cue: a small inverted square with a chevron, the
// tray's full height. Chips slide under it with a clean cut. The tray is what
// makes the squares read as the ends of a scrolling window at first sight,
// not only once you've scrolled. The squares echo the inverted count segment
// on each chip, and there are no fades anywhere: the design is hard-edged.
// Where everything fits (a desktop), no cue shows.
//
// The script below only says which edges hide chips; CSS draws the cues. The
// page's own script does the filtering and fills in the count
// ([data-filter-count]).
import FilterRow from "./FilterRow.astro";

export interface Props {
  counts: Record<string, number>;
  total: number;
  /** Shown selected in the static markup (the showcase); the page script sets it live. */
  selected?: string[];
}
const { counts, total, selected = [] } = Astro.props;
---

<div data-ui="filter-bar">
  <div data-filter-tray>
    <div data-filter-track>
      <div data-filter-scroller>
        <FilterRow counts={counts} selected={selected} />
      </div>
      <span data-filter-more="start" aria-hidden="true">‹</span>
      <span data-filter-more="end" aria-hidden="true">›</span>
    </div>
    <p data-filter-count aria-live="polite" class="shrink-0 px-3 font-mono text-xs text-[var(--text-muted)]">
      {total} of {total}
    </p>
  </div>
</div>

<script>
  // Mark which edges of the row still hide chips. A ResizeObserver catches
  // the first real layout too, since the bar starts hidden until the page
  // script has applied any filter from the URL.
  for (const track of document.querySelectorAll<HTMLElement>("[data-filter-track]")) {
    const scroller = track.querySelector<HTMLElement>("[data-filter-scroller]")!;
    const mark = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      track.toggleAttribute("data-more-start", scroller.scrollLeft > 1);
      track.toggleAttribute("data-more-end", scroller.scrollLeft < max - 1);
    };
    scroller.addEventListener("scroll", mark, { passive: true });
    new ResizeObserver(mark).observe(scroller);
    mark();
  }
</script>

<style>
  [data-ui="filter-bar"] {
    position: sticky;
    top: var(--nav-height);
    z-index: 9;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--border-primary);
    background-color: var(--bg-primary);
    --cue: 1.5rem;
  }

  /* The tray: one bar across the column, the page colour inside a 1px navy
     border, a crisp edge and no fill. It holds the scrolling chips and the
     result count. In light mode the chips take the paper colour too, set
     apart by their ink outline (no yellow). In dark mode their outline is
     too faint for that, so they keep their usual slate fill. */
  [data-filter-tray] {
    --tag-bg: var(--bg-primary);
    display: flex;
    align-items: center;
    border: 1px solid var(--accent-bg);
    background-color: var(--bg-primary);
  }

  @media (prefers-color-scheme: dark) {
    [data-filter-tray] {
      --tag-bg: var(--bg-secondary);
    }
  }

  /* The scrolling part of the tray; the cues pin to its ends. */
  [data-filter-track] {
    position: relative;
    flex: 1;
    min-width: 0;
    align-self: stretch;
  }

  [data-filter-scroller] {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding: 0.375rem;
    scrollbar-width: none;
    /* a chip scrolled into view (by focus or by the page script) lands
       clear of the cues */
    scroll-padding-inline: calc(var(--cue) + 0.5rem);
  }

  [data-filter-scroller]::-webkit-scrollbar {
    display: none;
  }

  [data-filter-scroller] :global([data-ui="filter-row"]) {
    flex-wrap: nowrap;
    width: max-content;
  }

  /* The cue: a square in the border's colour, the tray's full inner height,
     so it reads as a solid end-cap on the frame. Navy with a paper chevron;
     yellow with a dark one in dark mode. */
  [data-filter-more] {
    position: absolute;
    inset-block: 0;
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--cue);
    background-color: var(--accent-bg);
    color: var(--bg-primary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1;
    pointer-events: none;
  }

  [data-filter-more="start"] {
    left: 0;
  }

  [data-filter-more="end"] {
    right: 0;
  }

  [data-more-start] > [data-filter-more="start"],
  [data-more-end] > [data-filter-more="end"] {
    display: flex;
  }
</style>
