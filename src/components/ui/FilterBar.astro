---
// UI library: the blog index's control bar, sticky just under the site
// header. The chips alone, across the column, in their own approved look: no
// tray, no frame. Where they don't fit on one line (a phone), they wrap, so
// every chip is visible above the bar's rule and nothing scrolls sideways.
// No fades anywhere: the design is hard-edged.
//
// The result count is not here: the page captions its list with it.
import FilterRow from "./FilterRow.astro";

export interface Props {
  counts: Record<string, number>;
  /** Shown selected in the static markup (the showcase); the page script sets it live. */
  selected?: string[];
}
const { counts, selected = [] } = Astro.props;
---

<div data-ui="filter-bar">
  <FilterRow counts={counts} selected={selected} />
</div>

<style>
  [data-ui="filter-bar"] {
    position: sticky;
    top: var(--nav-height);
    z-index: 9;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--border-primary);
    background-color: var(--bg-primary);
  }
</style>
