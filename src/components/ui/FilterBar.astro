---
// UI library: the blog index's control bar. Sticky just under the site
// header, with the result count on the right.
//
// Phone: the chips live in a native popover, opened by the Filter button
// (popovertarget). Light dismiss and Escape come from the browser; the
// open/close animation is CSS (@starting-style, display and overlay
// transitions). The panel sits under the button by CSS anchor positioning;
// where that isn't supported (older Safari, so every iOS browser before it),
// the script below places it by hand. That is the one job here the platform
// can't do everywhere yet.
// Desktop: CSS overrides the popover so the same chips sit inline in one row;
// the button is hidden. No fades anywhere: the design is hard-edged.
//
// Script on the page fills in what HTML can't: the filtering itself, the
// count ([data-filter-count]) and the button's summary ([data-filter-summary]).
import Button from "./Button.astro";
import FilterRow from "./FilterRow.astro";

export interface Props {
  counts: Record<string, number>;
  total: number;
  /** Shown selected in the static markup (the showcase); the page script sets it live. */
  selected?: string[];
  id?: string;
}
const { counts, total, selected = [], id = "filter-panel" } = Astro.props;
const summary = selected.length === 0 ? "" : selected.length === 1 ? ` · ${selected[0]}` : ` · ${selected.length} tags`;
---

<div data-ui="filter-bar">
  <div class="flex items-center justify-between gap-4">
    <Button data-filter-toggle popovertarget={id} classes="md:hidden">
      Filter<span data-filter-summary>{summary}</span>&nbsp;▾
    </Button>
    <div id={id} popover data-filter-panel>
      <FilterRow counts={counts} selected={selected} />
    </div>
    <p data-filter-count aria-live="polite" class="shrink-0 font-mono text-xs text-[var(--text-muted)]">
      {total} of {total}
    </p>
  </div>
</div>

<script>
  // Without CSS anchor positioning, put the open panel just under its Filter
  // button, and keep it there while the page scrolls (the bar is sticky, so
  // the button moves until it pins under the header). Inline styles are
  // cleared on close so they never leak into the desktop's inline layout.
  if (!CSS.supports("position-area: bottom")) {
    for (const bar of document.querySelectorAll<HTMLElement>('[data-ui="filter-bar"]')) {
      const toggle = bar.querySelector<HTMLElement>("[data-filter-toggle]");
      const panel = bar.querySelector<HTMLElement>("[data-filter-panel]");
      if (!toggle || !panel) continue;

      const place = () => {
        const r = toggle.getBoundingClientRect();
        Object.assign(panel.style, { position: "fixed", inset: "auto", margin: "0", top: `${r.bottom + 8}px`, left: `${r.left}px` });
      };
      const follow = () => {
        if (panel.matches(":popover-open")) place();
      };

      panel.addEventListener("beforetoggle", (event) => {
        if ((event as ToggleEvent).newState === "open") place();
      });
      panel.addEventListener("toggle", (event) => {
        if ((event as ToggleEvent).newState === "closed") {
          for (const prop of ["position", "inset", "margin", "top", "left"]) panel.style.removeProperty(prop);
        }
      });
      addEventListener("scroll", follow, { passive: true });
      addEventListener("resize", follow);
    }
  }
</script>

<style>
  [data-ui="filter-bar"] {
    position: sticky;
    top: var(--nav-height);
    z-index: 9;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--border-primary);
    background-color: var(--bg-primary);
  }

  [data-filter-toggle] {
    anchor-name: --filter-toggle;
  }

  /* Phone: a popover panel under the Filter button. */
  [data-filter-panel] {
    position-anchor: --filter-toggle;
    position-area: bottom span-right;
    inset: auto;
    margin: 0.5rem 0 0;
    width: min(24rem, calc(100vw - 2rem));
    padding: 1rem;
    border: 1px solid var(--border-primary);
    background-color: var(--bg-primary);
    color: inherit;
    opacity: 0;
    translate: 0 -0.25rem;
    transition:
      opacity 180ms ease,
      translate 180ms ease,
      display 180ms allow-discrete,
      overlay 180ms allow-discrete;
  }

  [data-filter-panel]:popover-open {
    opacity: 1;
    translate: 0 0;
  }

  @starting-style {
    [data-filter-panel]:popover-open {
      opacity: 0;
      translate: 0 -0.25rem;
    }
  }

  /* Desktop: the same chips, inline in one row. No button, no popup. */
  @media (min-width: 768px) {
    [data-filter-panel] {
      display: block;
      position: static;
      flex: 1;
      width: auto;
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
      opacity: 1;
      translate: none;
      overflow: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-filter-panel] {
      transition: none;
    }
  }
</style>
