---
// UI library: a post's metadata (author, date in words, tags). It owns the
// view-transition names for the byline and tags, so every page that shows a
// post's metadata morphs the same way.
//
// One structure everywhere: the byline on its own line, then the tag row.
// Tags never sit beside the byline, so between an index and a post every
// piece moves in one shared direction and nothing crosses anything else
// (view-transitions.spec.ts). The byline is sized to its text with
// proportional line height, so its shape holds and the morph scales it evenly.
//
//   size="entry"   index rows
//   size="header"  the post header; extras after the date go in
//                  <slot name="byline-end">, actions (the Share button) in
//                  <slot name="actions"> at the end of the tag row
import Tag from "./Tag.astro";
import { formatPostDate, isoPostDate } from "../../utils/dates";
import { postTransition } from "../../utils/transitions";

export interface Props {
  author: string;
  date: string;
  updated?: string;
  tags: string[];
  hash: string;
  size?: "entry" | "header";
}
const { author, date, updated, tags, hash, size = "entry" } = Astro.props;
const byline = size === "header" ? "mb-3 text-base" : "mb-2 text-sm";
---

<div data-ui="post-meta">
  <p data-byline style={postTransition(hash, "byline")} class={`${byline} w-fit leading-[1.5] text-[var(--text-muted)]`}>
    {author} · <time datetime={isoPostDate(date)}>{formatPostDate(date)}</time>
    {updated && <> · Updated <time datetime={isoPostDate(updated)}>{formatPostDate(updated)}</time></>}
    <slot name="byline-end" />
  </p>
  <!-- wraps so that, when the tags and Share don't fit on one line, Share
       moves under the tags rather than squeezing them onto two lines: the
       tag row keeps the shape it has in the list, so the morph scales it
       evenly (ui-post.spec.ts) -->
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div style={postTransition(hash, "tags")} class="flex flex-wrap items-center gap-x-3 gap-y-1">
      {tags.map((tag) => <Tag>{tag}</Tag>)}
    </div>
    <slot name="actions" />
  </div>
</div>

<style>
  /* The byline sits slightly into the page, like letterpress: a faint
     highlight under each letter's lower edge and a fainter shadow above. A
     deliberate exception to the flat style, kept subtle; byline.spec.ts
     holds it to 4.5:1 contrast in both schemes. */
  [data-byline] {
    text-shadow:
      0 1px 0 rgba(255, 255, 255, 0.85),
      0 -1px 0 rgba(0, 0, 0, 0.05);
  }

  @media (prefers-color-scheme: dark) {
    [data-byline] {
      text-shadow:
        0 1px 0 rgba(255, 255, 255, 0.05),
        0 -1px 0 rgba(0, 0, 0, 0.6);
    }
  }
</style>
