---
// UI library: one filter toggle for the blog index. Unpressed it looks like a
// Tag (so the link to the tags on each post reads naturally); pressed it fills
// with the primary button colour. An optional count is a solid segment at the
// chip's right end, running its full height.
export interface Props {
  label: string;
  count?: number;
  pressed?: boolean;
}
const { label, count, pressed = false } = Astro.props;
---

<button type="button" data-ui="filter-chip" data-label={label} aria-pressed={String(pressed)}>
  <span data-label-text>{label}</span>{count !== undefined && <span data-count>{count}</span>}
</button>

<style>
  [data-ui="filter-chip"] {
    display: inline-flex;
    align-items: stretch;
    padding: 0;
    border: 1px solid var(--border-primary);
    background-color: var(--tag-bg, var(--bg-secondary));
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.25rem;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }

  [data-ui="filter-chip"] [data-label-text] {
    padding: 0.125rem 0.625rem;
  }

  /* The count reads as a count, not part of the label: much smaller (9px
     against the label's 12px), inverted (the number in the chip's own colour
     on a solid fill), and set as a segment flush to the chip's right edge,
     running its full height. Same colours whether the chip is pressed or not. */
  [data-ui="filter-chip"] [data-count] {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    padding: 0 0.375rem;
    background-color: var(--text-muted);
    color: var(--tag-bg, var(--bg-secondary));
    font-size: 0.5625rem;
    line-height: 1;
  }

  [data-ui="filter-chip"][aria-pressed="false"]:hover {
    border-color: var(--text-accent);
  }

  [data-ui="filter-chip"][aria-pressed="true"] {
    border-color: var(--accent-bg);
    background-color: var(--accent-bg);
    color: var(--bg-primary);
  }


  [data-ui="filter-chip"]:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }
</style>
