---
import { Image } from "astro:assets";
import Profile from "../assets/Profile.webp";
// Traced from the photo by scripts/avatar-silhouette.mjs; rerun it if the photo changes.
import silhouette from "../assets/profile-silhouette.svg?raw";
import Container from "./Container.astro";
---

<Container
  classes="w-full h-fit flex flex-col justify-start items-center pt-[5vh] md:max-w-[640px] max-w-[350px] mx-auto"
>
  <!-- The frame carries the photo's own backdrop (sampled from its left and
       right edges), so it shows grey, not paper, while the photo loads, with a
       slightly darker head-and-shoulders silhouette traced from the photo in
       the same spot; the photo then appears over it (no fade: it read as a
       flutter). Resample if
       Profile.webp changes; hero.spec.ts checks both still match. -->
  <figure
    class="relative h-[200px] w-[200px] md:h-[400px] md:w-[400px] border border-[var(--border-primary)] bg-[linear-gradient(to_right,#bcbab6,#b4b1ab)]"
  >
    <div class="absolute inset-0 [&>svg]:h-full [&>svg]:w-full" set:html={silhouette} />
    <Image
      src={Profile}
      alt="Nathan Tranquilla Profile"
      class="relative h-full w-full"
      widths={[350, 550]}
      layout="constrained"
    />
  </figure>
  <h1
    class="pt-5 font-serif text-4xl font-medium tracking-tight text-nowrap text-[var(--text-primary)] md:text-6xl"
  >
    Nathan Tranquilla
  </h1>
  <p
    class="w-full py-4 text-center font-sans text-[var(--text-secondary)] md:text-xl"
  >
    Type safety and AI in software development, and the seam where they meet.
  </p>
</Container>

