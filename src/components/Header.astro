---
import Nav from "../components/Nav.astro";
import Button from "../components/Button.astro";
import Logo from "../components/Logo.astro";
---

<header
  class="sticky top-0 z-10 col-start-1 col-end-4 row-start-1 flex h-[var(--nav-height)] items-center justify-start bg-[var(--header-bg)] backdrop-blur-sm px-4 border-b border-[var(--border-primary)]"
>
  <a
    href="/"
    aria-label="Nathan Tranquilla, home"
    class="flex h-full items-center text-[var(--text-primary)] transition-colors duration-200 hover:text-[var(--text-accent)]"
  >
    <Logo />
  </a>
  <Nav />
  <Button
    href="/consultation"
    classes="hidden md:block ml-auto flex items-center self-center"
    >Work With Me</Button
  >
</header>
