---
import type { HTMLAttributes } from "astro/types";

export interface Props extends Omit<HTMLAttributes<"button">, "class"> {
  classes?: string;
  /** Renders a link when set; otherwise a `<button type="button">`. */
  href?: string;
  /** Use on dark surfaces such as the footer, where the default navy vanishes. */
  invert?: boolean;
}
const { classes, href, invert = false, ...rest } = Astro.props;

const base =
  "text-nowrap font-mono text-sm uppercase tracking-[0.07em] py-2 px-6 w-fit h-fit cursor-pointer border transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2";
const skin = invert
  ? "bg-[var(--bg-secondary)] text-[var(--bg-surface)] border-[var(--bg-secondary)] hover:bg-[var(--text-accent-hover)] focus:ring-[var(--bg-secondary)]"
  : "bg-[var(--accent-bg)] text-[var(--bg-primary)] border-[var(--border-primary)] hover:bg-[var(--accent-bg-hover)] focus:ring-[var(--accent-bg)]";
const className = `${base} ${skin} ${classes || ""}`;
---

{href ? (
  <a href={href} class={className}>
    <slot />
  </a>
) : (
  <button type="button" class={className} {...rest}>
    <slot />
  </button>
)}
