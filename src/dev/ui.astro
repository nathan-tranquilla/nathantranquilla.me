---
// UI library showcase. Dev only: astro.config.mjs injects /ui under
// `astro dev` and nowhere else, so it never reaches the production build.
// Switch the OS or devtools color scheme to see the other mode.
// Standalone: no site layout, just the global styles the components use.
import "../styles/global.css";
import Button from "../components/ui/Button.astro";
import Callout from "../components/ui/Callout.astro";
import Tag from "../components/ui/Tag.astro";
import PostMeta from "../components/ui/PostMeta.astro";
import PostEntry from "../components/ui/PostEntry.astro";
import FilterRow from "../components/ui/FilterRow.astro";
import { getPosts } from "../utils/posts";
import { tagCounts } from "../utils/tags";

const counts = tagCounts(getPosts().filter((p) => !p.frontmatter.draft));

// A made-up post for the specimens; its hash is unique to this page.
const samplePost = {
  url: "/ui",
  frontmatter: { title: "A Sample Post Title", author: "Nathan Tranquilla", date: "2026/10/01", tags: ["AI", "Finance"], hash: "uidemo" },
};

const surfaces = [
  { variant: "primary", surface: "bg-[var(--bg-primary)]", note: "Default. On paper and the page ground." },
  { variant: "inverse", surface: "bg-[var(--bg-footer)]", note: "On dark surfaces, like the footer." },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>UI library</title>
  </head>
  <body>
    <main class="mx-auto w-full max-w-[900px] px-4 py-12">
      <h1 class="mb-2 font-serif text-3xl font-semibold text-[var(--text-primary)]">UI library</h1>
      <p class="mb-10 font-mono text-sm text-[var(--text-muted)]">
        src/components/ui/ · dev only · switch your color scheme to check the other mode
      </p>

      <section>
        <h2 class="mb-4 font-serif text-2xl text-[var(--text-primary)]">Button</h2>
        {surfaces.map(({ variant, surface, note }) => (
          <div class="mb-8">
            <p class="mb-2 font-mono text-xs uppercase tracking-[0.07em] text-[var(--text-muted)]">
              variant="{variant}" · {note}
            </p>
            <div class={`flex flex-wrap items-center gap-4 border border-[var(--border-primary)] p-6 ${surface}`}>
              <Button href="#" variant={variant}>As a link</Button>
              <Button variant={variant}>As a button</Button>
              <Button variant={variant} disabled>Disabled</Button>
            </div>
          </div>
        ))}
        <div class="mb-8">
          <p class="mb-2 font-mono text-xs uppercase tracking-[0.07em] text-[var(--text-muted)]">
            aria-pressed · Toggles, such as a range switch. On the page ground only.
          </p>
          <div class="flex flex-wrap items-center gap-4 border border-[var(--border-primary)] p-6">
            <Button aria-pressed="true">Pressed</Button>
            <Button aria-pressed="false">Not pressed</Button>
          </div>
        </div>
        <p class="font-mono text-xs text-[var(--text-muted)]">
          In markdown: &lt;a href="…" data-ui="button" data-variant="primary"&gt;…&lt;/a&gt;
        </p>
      </section>

      <section class="mt-12">
        <h2 class="mb-4 font-serif text-2xl text-[var(--text-primary)]">Callout</h2>
        <Callout label="A few terms">
          <ul class="list-disc space-y-1 pl-5">
            <li><strong>Journal:</strong> a plain-text file where transactions are recorded.</li>
            <li><strong>Reconcile:</strong> to make your records match the bank's balance.</li>
          </ul>
        </Callout>
        <p class="font-mono text-xs text-[var(--text-muted)]">
          In markdown: &lt;aside data-ui="callout"&gt;&lt;p data-callout-label&gt;Label&lt;/p&gt; …markdown… &lt;/aside&gt; (blank lines around the markdown)
        </p>
      </section>

      <section class="mt-12">
        <h2 class="mb-4 font-serif text-2xl text-[var(--text-primary)]">Tag</h2>
        <div class="mb-3 flex gap-3 border border-[var(--border-primary)] p-6">
          <Tag>AI</Tag><Tag>Finance</Tag>
        </div>
        <div class="flex gap-3 border border-[var(--border-primary)] bg-[var(--bg-secondary)] p-6 [--tag-bg:var(--bg-primary)]">
          <Tag>On the yellow band</Tag>
        </div>
      </section>

      <section class="mt-12">
        <h2 class="mb-4 font-serif text-2xl text-[var(--text-primary)]">PostMeta</h2>
        <p class="mb-2 font-mono text-xs uppercase tracking-[0.07em] text-[var(--text-muted)]">size="entry" · index rows</p>
        <div class="mb-6 border border-[var(--border-primary)] p-6">
          <PostMeta author="Nathan Tranquilla" date="2026/10/01" tags={["AI", "Finance"]} hash="uimeta1" />
        </div>
        <p class="mb-2 font-mono text-xs uppercase tracking-[0.07em] text-[var(--text-muted)]">size="header" · the post header, with an action</p>
        <div class="border border-[var(--border-primary)] p-6">
          <PostMeta size="header" author="Nathan Tranquilla" date="2026/10/01" tags={["AI", "Finance"]} hash="uimeta2">
            <Button slot="actions">Share</Button>
          </PostMeta>
        </div>
      </section>

      <section class="mt-12">
        <h2 class="mb-4 font-serif text-2xl text-[var(--text-primary)]">FilterRow and FilterChip</h2>
        <p class="mb-4 font-mono text-xs text-[var(--text-muted)]">
          For the blog index. Real post counts. Several tags narrow to posts with all of them. Look only: no behaviour yet.
        </p>
        <p class="mb-2 font-mono text-xs uppercase tracking-[0.07em] text-[var(--text-muted)]">Nothing selected</p>
        <div class="mb-6 border border-[var(--border-primary)] p-6"><FilterRow counts={counts} /></div>
        <p class="mb-2 font-mono text-xs uppercase tracking-[0.07em] text-[var(--text-muted)]">One tag</p>
        <div class="mb-6 border border-[var(--border-primary)] p-6"><FilterRow counts={counts} selected={["AI"]} /></div>
        <p class="mb-2 font-mono text-xs uppercase tracking-[0.07em] text-[var(--text-muted)]">Two tags: posts with both</p>
        <div class="border border-[var(--border-primary)] p-6"><FilterRow counts={counts} selected={["AI", "Coding"]} /></div>
      </section>

      <section class="mt-12">
        <h2 class="mb-4 font-serif text-2xl text-[var(--text-primary)]">PostEntry</h2>
        <div class="divide-y divide-[var(--border-primary)] border border-[var(--border-primary)] p-6">
          <PostEntry post={samplePost} />
        </div>
      </section>
    </main>
  </body>
</html>
