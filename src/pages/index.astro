---
import { formatPostDate } from "../utils/dates";
import { postTransition } from "../utils/transitions";
import Main from "../layouts/Main.astro";
import Hero from "../components/Hero.astro";
import Container from "../components/Container.astro";
import H2 from "../components/HTMLElements/H2.astro";
import RightArrow from "../components/RightArrow.astro";
import { getPosts } from "../utils/posts";

const posts = getPosts().slice(0, 3);

---

<Main
  title="nathantranquilla.me | Type Safety and AI in Software Development"
  description="Nathan Tranquilla writes about type safety and AI in software development."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Nathan Tranquilla",
    "url": "https://nathantranquilla.me",
    "description": "Nathan Tranquilla writes about type safety and AI in software development.",
    "author": {
      "@type": "Person",
      "name": "Nathan Tranquilla"
    },
    "inLanguage": "en-US"
  })} />
  <Hero />

  <div class="bg-[var(--bg-secondary)]">
  <Container classes="w-full max-w-4xl mx-auto">
    <H2 classes="mb-8 text-[var(--text-primary)]">Recent Posts</H2>
    <div class="divide-y divide-[var(--border-primary)]">
      {
        posts.map((post) => (
          <article class="py-6 first:pt-0">
            <a href={post.url} class="group block">
              <h3 style={postTransition(post.frontmatter.hash, "title")} class="mb-1 font-serif text-lg text-[var(--text-primary)] transition-colors duration-200 group-hover:text-[var(--text-accent)] md:text-xl">
                {post.frontmatter.title}
              </h3>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <span style={postTransition(post.frontmatter.hash, "byline")} class="text-sm text-[var(--text-muted)]">
                  {post.frontmatter.author} · {formatPostDate(post.frontmatter.date)}
                </span>
                <span style={postTransition(post.frontmatter.hash, "tags")} class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  {post.frontmatter.tags.map((tag: string) => (
                    <span class="border border-[var(--border-primary)] bg-[var(--bg-secondary)] px-2.5 py-0.5 font-mono text-xs text-[var(--text-tertiary)]">
                      {tag}
                    </span>
                  ))}
                </span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
    <a
      href="/blogs"
      class="mt-6 inline-flex items-center font-semibold text-[var(--text-accent)] hover:text-[var(--text-accent-hover)]"
    >
      View all posts
      <RightArrow />
    </a>
  </Container>
  </div>
</Main>
