---
import Main from "../layouts/Main.astro";
import Container from "../components/Container.astro";
import Button from "../components/ui/Button.astro";

const inputClasses = "w-full rounded-md border border-[var(--border-primary)] bg-[var(--bg-primary)] text-[var(--text-secondary)] px-3 py-2 focus:ring-2 focus:ring-[var(--accent-bg)] focus:outline-none focus:border-[var(--accent-bg)] transition-colors";
const labelClasses = "block text-sm font-semibold text-[var(--text-primary)] mb-1";
const formAction = import.meta.env.PROD ? "https://formspree.io/f/xzdarlpg" : "#";
---

<Main
  title="nathantranquilla.me | Consultation"
  description="Book a consultation with Nathan Tranquilla for Web Development or AI Consulting."
>
  <Container classes="w-full max-w-[600px] mx-auto font-sans">
    <h1 class="text-2xl md:text-3xl font-serif font-semibold text-[var(--text-primary)] mb-2">
      Book a Consultation
    </h1>
    <p class="text-[var(--text-muted)] mb-6">
      Tell me a little about what you need and I'll get back to you within 48 hours. Only the first three fields are required.
    </p>

    <form action={formAction} method="POST" data-testid="intake-form" class="space-y-6">
      <div>
        <label for="name" class={labelClasses}>Name <span class="text-red-500">*</span></label>
        <input type="text" id="name" name="name" required class={inputClasses} />
      </div>

      <div>
        <label for="email" class={labelClasses}>Email <span class="text-red-500">*</span></label>
        <input type="email" id="email" name="email" required class={inputClasses} />
      </div>

      <div>
        <label for="message" class={labelClasses}>What do you need help with? <span class="text-red-500">*</span></label>
        <textarea id="message" name="message" required rows="5" class={inputClasses}></textarea>
      </div>

      <div>
        <label for="company" class={labelClasses}>Company or website</label>
        <input type="text" id="company" name="company" class={inputClasses} />
      </div>

      <div>
        <label for="work-type" class={labelClasses}>Type of work</label>
        <select id="work-type" name="work_type" class={inputClasses}>
          <option value="">Select one</option>
          <option value="Web development">Web development</option>
          <option value="AI">AI</option>
          <option value="Not sure">Not sure</option>
        </select>
      </div>

      <div>
        <label for="timeline" class={labelClasses}>Timeline</label>
        <input type="text" id="timeline" name="timeline" placeholder="e.g. next month, flexible" class={inputClasses} />
      </div>

      <div>
        <label for="budget" class={labelClasses}>Budget</label>
        <input type="text" id="budget" name="budget" placeholder="e.g. $5k, flexible, not sure yet" class={inputClasses} />
      </div>

      <div>
        <label for="source" class={labelClasses}>How did you find me?</label>
        <input type="text" id="source" name="source" class={inputClasses} />
      </div>

      <Button type="submit" classes="w-full">Submit</Button>
    </form>
  </Container>
</Main>
