---
import PostEntry from "../components/ui/PostEntry.astro";
import Container from "../components/Container.astro";
import Main from "../layouts/Main.astro";
import H1 from "../components/HTMLElements/H1.astro";
import { getPosts } from "../utils/posts";
const posts = getPosts();


posts.forEach((post) => {
  if (!/^\d{4}\/\d{2}\/\d{2}$/.test(post.frontmatter.date)) {
    throw new Error(
      `Invalid date format: ${post.frontmatter.date}. Expected YYYY/MM/DD`,
    );
  }
});
---

<Main title="nathantranquilla.me | Blog Posts" description="Type safety and AI in software development, and the seam where they meet.">
  <Container classes="w-full max-w-4xl mx-auto py-8 px-4">
    <div class="mb-12 text-center">
      <H1 classes="mb-4">Blog</H1>
      <p class="mx-auto max-w-2xl text-xl leading-relaxed text-[var(--text-tertiary)]">
        Type safety and AI in software development, and the seam where they meet.
      </p>
    </div>

    <div class="divide-y divide-[var(--border-primary)]">
      {
        posts.map((post) => <PostEntry post={post} level={2} />)
      }
    </div>

    {
      posts.length === 0 && (
        <div class="py-16 text-center">
          <div class="mb-4 text-6xl">📝</div>
          <h2 class="mb-2 text-2xl font-bold text-[var(--text-primary)]">No posts yet</h2>
          <p class="text-[var(--text-tertiary)]">
            Check back soon for insights on Next-Gen Web Development!
          </p>
        </div>
      )
    }
  </Container>
</Main>
